# Donnees personnelles des locataires — ne jamais committer
/dossiers/*
!/dossiers/.gitkeep

# Emails transferes (contiennent des pieces d'identite)
/inbox/*
!/inbox/.gitkeep

# Config reelle (garder les exemples versionnes)
/config/logement.yaml
/config/pieces_requises.yaml
/config/rentila_import.yaml
/config/biens_fiscal.yaml
/config/biens_fiscal.json
/config/rentila_selectors.json

# Captures reseau (HAR) : cookies de session + donnees personnelles
/captures/
*.har

# Automatisation Playwright : session (cookies) et captures d'ecran = sensibles
/automation/.auth/
/automation/captures/
/automation/node_modules/

# Registre reel (noms de locataires + contrats = donnees personnelles)
/registre/locataires.json
/registre/contrats.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editeurs
.DS_Store
*.swp
