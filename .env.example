# Identifiants API Rentila (Direct API, pour scripts/cron).
# Generez client_id + client_secret depuis votre profil Rentila (le secret n'est
# affiche qu'UNE SEULE FOIS). Copiez ce fichier en `.env`, remplissez, puis :
#   set -a; . ./.env; set +a
# Ne committez JAMAIS le fichier .env (il est git-ignore).

RENTILA_CLIENT_ID=
RENTILA_CLIENT_SECRET=
