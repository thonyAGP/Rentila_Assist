{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Locataire",
  "description": "Donnees d'un nouveau locataire extraites de la piece d'identite et de l'email transfere. Toute valeur non trouvee doit rester null (ne jamais inventer).",
  "type": "object",
  "properties": {
    "identite": {
      "type": "object",
      "properties": {
        "civilite": { "type": ["string", "null"], "enum": ["M.", "Mme", null] },
        "nom_naissance": { "type": ["string", "null"], "description": "Nom de famille / nom de naissance" },
        "nom_usage": { "type": ["string", "null"], "description": "Nom d'usage si different (ex: nom marital)" },
        "prenoms": { "type": ["string", "null"], "description": "Tous les prenoms, dans l'ordre de la piece" },
        "sexe": { "type": ["string", "null"], "enum": ["F", "M", null] },
        "date_naissance": { "type": ["string", "null"], "description": "Format AAAA-MM-JJ" },
        "lieu_naissance": { "type": ["string", "null"] },
        "nationalite": { "type": ["string", "null"] }
      }
    },
    "piece_identite": {
      "type": "object",
      "properties": {
        "type": { "type": ["string", "null"], "enum": ["CNI", "Passeport", "Titre de sejour", null] },
        "numero": { "type": ["string", "null"] },
        "date_delivrance": { "type": ["string", "null"], "description": "Format AAAA-MM-JJ" },
        "date_expiration": { "type": ["string", "null"], "description": "Format AAAA-MM-JJ" },
        "autorite_delivrance": { "type": ["string", "null"] },
        "mrz": { "type": ["string", "null"], "description": "Ligne(s) MRZ au bas du document si lisibles, utile pour recouper" }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": { "type": ["string", "null"], "description": "Depuis le corps de l'email ou l'expediteur" },
        "telephone": { "type": ["string", "null"] },
        "adresse_actuelle": { "type": ["string", "null"] }
      }
    },
    "situation": {
      "type": "object",
      "properties": {
        "statut": { "type": ["string", "null"], "enum": ["Salarie", "Etudiant", "Fonctionnaire", "Independant", "Retraite", "Demandeur d'emploi", "Autre", null] },
        "employeur": { "type": ["string", "null"] },
        "type_contrat": { "type": ["string", "null"], "enum": ["CDI", "CDD", "Interim", "Alternance", "Stage", "Autre", null] },
        "revenu_mensuel_net": { "type": ["number", "null"], "description": "En euros, si mentionne dans l'email" }
      }
    },
    "garant": {
      "type": ["object", "null"],
      "properties": {
        "nom_complet": { "type": ["string", "null"] },
        "lien": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] }
      }
    },
    "visale": {
      "type": "object",
      "properties": {
        "numero_visa": { "type": ["string", "null"], "description": "Numero du visa certifie Visale si le candidat l'a deja obtenu" },
        "eligible_pressenti": { "type": ["string", "null"], "enum": ["Oui", "Non", "A verifier", null] }
      }
    },
    "photo_profil": {
      "type": ["string", "null"],
      "description": "Chemin relatif vers la photo extraite/recadree utilisee comme photo de profil"
    },
    "meta": {
      "type": "object",
      "properties": {
        "source_email": { "type": ["string", "null"] },
        "pieces_jointes": { "type": "array", "items": { "type": "string" } },
        "confiance_globale": { "type": ["string", "null"], "enum": ["Haute", "Moyenne", "Faible", null] },
        "champs_incertains": { "type": "array", "items": { "type": "string" }, "description": "Liste des champs a re-verifier manuellement" }
      }
    }
  }
}
